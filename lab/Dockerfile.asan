FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential autoconf bison pkg-config re2c \
    libxml2-dev libsqlite3-dev libonig-dev \
    nginx procps curl ca-certificates wget \
    && rm -rf /var/lib/apt/lists/*

RUN cd /tmp && \
    wget -q https://www.php.net/distributions/php-8.4.4.tar.xz && \
    tar xf php-8.4.4.tar.xz && \
    cd php-8.4.4 && \
    ./configure \
        --enable-fpm \
        --enable-address-sanitizer \
        --with-config-file-path=/usr/local/etc/php \
        --disable-all \
        --enable-session \
        --enable-filter \
        --enable-ctype \
        --enable-tokenizer \
        --enable-posix && \
    make -j$(nproc) && \
    make install && \
    cd / && rm -rf /tmp/php-8.4.4*

RUN mkdir -p /var/log/php-fpm /var/log/asan /var/lib/php/sessions /run/php \
        /usr/local/etc/php-fpm.d \
    && chown www-data:www-data /var/lib/php/sessions /var/log/asan \
    && chmod 1733 /var/lib/php/sessions \
    && cp /usr/local/etc/php-fpm.conf.default /usr/local/etc/php-fpm.conf \
    && sed -i 's|;*include=.*|include=/usr/local/etc/php-fpm.d/*.conf|' /usr/local/etc/php-fpm.conf \
    && sed -i 's|;*error_log =.*|error_log = /proc/self/fd/2|' /usr/local/etc/php-fpm.conf

COPY php.ini /usr/local/etc/php/php.ini
COPY www.conf /usr/local/etc/php-fpm.d/www.conf
COPY nginx.conf /etc/nginx/nginx.conf
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV ASAN_OPTIONS="detect_leaks=0:abort_on_error=0:log_path=/var/log/asan/report:print_stacktrace=1:halt_on_error=0:verify_asan_link_order=0"
EXPOSE 80
CMD ["/entrypoint.sh"]
